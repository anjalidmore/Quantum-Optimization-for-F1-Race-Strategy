# Shared by the root (backend) and frontend/ Docker builds.
#
# artifacts/ and data/ are intentionally excluded from every image: they are
# generated by scripts/build_all.py outside Docker and bind-mounted in at
# runtime (see docker-compose.yml), not copied into either image.
artifacts/
data/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
build/
dist/
.git/
.github/
docs/
tests/
practicals/
design-screenshots/
fastf1_cache/
.fastf1_cache/
*.md
reference.png

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
