</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#driver_has_result">
  <rdfs:domain rdf:resource="#Driver"/>
  <rdfs:range rdf:resource="#Result"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A driver has classified results.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#result_in_race">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Result"/>
  <rdfs:range rdf:resource="#Race"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A result is recorded for a race.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#driver_has_standing">
  <rdfs:domain rdf:resource="#Driver"/>
  <rdfs:range rdf:resource="#DriverStanding"/>
