</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#strategy_recommends_pitstop">
  <rdfs:domain rdf:resource="#Strategy"/>
  <rdfs:range rdf:resource="#PitStop"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strategy recommends pit stops.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#strategy_recommends_tyre">
  <rdfs:domain rdf:resource="#Strategy"/>
  <rdfs:range rdf:resource="#TyreCompound"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strategy recommends tyre compounds.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#strategy_predicts_position">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Strategy"/>
  <rdfs:range rdf:resource="#Position"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strategy predicts a finish position.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prediction_generates_recommendation">
  <rdfs:domain rdf:resource="#Prediction"/>
  <rdfs:range rdf:resource="#Recommendation"/>
