<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://f1kr.org/ontology/formula1"
         xmlns="http://f1kr.org/ontology/formula1#">

<owl:Ontology rdf:about="http://f1kr.org/ontology/formula1"/>

<owl:ObjectProperty rdf:about="#drives_for">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Driver"/>
  <rdfs:range rdf:resource="#Constructor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A driver competes on behalf of a constructor.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#owns">
  <rdfs:domain rdf:resource="#Constructor"/>
  <rdfs:range rdf:resource="#Car"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A constructor owns / fields cars.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#participates_in">
  <rdfs:domain rdf:resource="#Driver"/>
  <rdfs:range rdf:resource="#Race"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A driver takes part in a race.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#held_at">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Race"/>
  <rdfs:range rdf:resource="#Circuit"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A race is held at a circuit.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#belongs_to_season">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Race"/>
  <rdfs:range rdf:resource="#Season"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A race belongs to a season.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#instance_of_gp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Race"/>
  <rdfs:range rdf:resource="#GrandPrix"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A race is an instance of a recurring Grand Prix.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contains_lap">
  <rdfs:domain rdf:resource="#Race"/>
  <rdfs:range rdf:resource="#Lap"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A race contains laps.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#lap_of_driver">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Lap"/>
  <rdfs:range rdf:resource="#Driver"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lap is driven by a driver.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#lap_in_session">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Lap"/>
  <rdfs:range rdf:resource="#Session"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lap belongs to a session.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#lap_has_telemetry">
  <rdfs:domain rdf:resource="#Lap"/>
  <rdfs:range rdf:resource="#Telemetry"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lap carries telemetry samples.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#lap_has_sector">
  <rdfs:domain rdf:resource="#Lap"/>
  <rdfs:range rdf:resource="#Sector"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lap is divided into sectors.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#sector_has_time">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Sector"/>
  <rdfs:range rdf:resource="#SectorTime"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sector has a measured sector time.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#performs_pitstop">
  <rdfs:domain rdf:resource="#Driver"/>
  <rdfs:range rdf:resource="#PitStop"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A driver performs pit stops.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pitstop_changes_tyre">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PitStop"/>
  <rdfs:range rdf:resource="#TyreCompound"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pit stop changes to a tyre compound.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pitstop_begins_stint">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#PitStop"/>
  <rdfs:range rdf:resource="#Stint"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pit stop begins a new stint.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#stint_uses_compound">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Stint"/>
  <rdfs:range rdf:resource="#TyreCompound"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A stint runs on a tyre compound.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#weather_affects_strategy">
  <rdfs:domain rdf:resource="#Weather"/>
  <rdfs:range rdf:resource="#Strategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Weather conditions influence strategy.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#safetycar_affects_pitwindow">
  <rdfs:domain rdf:resource="#SafetyCar"/>
  <rdfs:range rdf:resource="#PitWindow"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Safety-car deployment shifts the optimal pit window.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#trackstatus_affects_strategy">
  <rdfs:domain rdf:resource="#TrackStatus"/>
  <rdfs:range rdf:resource="#Strategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Track status influences strategy.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#telemetry_influences_prediction">
  <rdfs:domain rdf:resource="#Telemetry"/>
  <rdfs:range rdf:resource="#Prediction"/>
